[Unit]
Description=Digitization Toolkit — per-unit secret generation (first boot / cloned card)
Documentation=https://github.com/UCSB-AMPLab/digitization-toolkit-software
# Needs Docker to rotate the Postgres password inside the db container, and
# must finish before dtk.service starts the backend against .env.
After=docker.service
Requires=docker.service
Before=dtk.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/home/pi/dtk/scripts/generate-secrets.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dtk-secrets

[Install]
WantedBy=multi-user.target
