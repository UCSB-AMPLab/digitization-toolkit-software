# Database Configuration
DATABASE_NAME=digitoolkit
DATABASE_USER=dtkadmin
DATABASE_PASSWORD=change-this-in-production
DATABASE_HOST=localhost  # Production native backend; Docker overrides to 'db'
DATABASE_PORT=5432

# Application Configuration
# Use dev/development/test/local for development; other values require a strong SECRET_KEY
APP_ENV=dev
# Generate with: openssl rand -hex 32
SECRET_KEY=secret-key-here-change-in-production
# First-user bootstrap token. Required outside dev; generate per unit at first boot.
# Generate with: openssl rand -hex 32
BOOTSTRAP_TOKEN=
# Session lifetime in seconds (default: 28800)
ACCESS_TOKEN_EXPIRE_SECONDS=28800

DTK_DATA_DIR=/var/lib/dtk
DTK_LOG_DIR=/var/log/dtk
PROJECTS_ROOT=/var/lib/dtk/projects
# Optional export directory override
DTK_EXPORTS_DIR=/var/lib/dtk/exports
# Max upload size in bytes (default: 100 MB)
DTK_MAX_UPLOAD_BYTES=104857600

# Camera Configuration
# Available backends: picamera2, subprocess, gphoto2, chdk
CAMERA_BACKEND=picamera2

# Offsite catalogue backup (NEH-249)
# The appliance dumps its own database and pushes it to the same bucket as the
# images, on the same scoped key and the same bandwidth cap. Without the
# catalogue the images are an unordered heap of files named by timestamp, which
# is what the Rionegro unit nearly became on 2026-09-15: 87.7 GiB of images
# offsite, no database dump at all, and a card with 48 KB free.
#
# SIX OF THESE ARE WRITTEN ELSEWHERE AT PROVISIONING TIME, and so are the two
# Fisqua keys further down.
# scripts/provision-rclone.sh writes DTK_OFFSITE_REMOTE, DTK_RCLONE_BIN,
# DTK_RCLONE_CONFIG, DTK_OFFSITE_READ_REMOTE, DTK_OFFSITE_TENANT,
# DTK_OFFSITE_DUMP_RECIPIENT, DTK_FISQUA_TOKEN and DTK_FISQUA_ENV to
# /var/lib/dtk/offsite.env, which the backend
# reads IN ADDITION to this file and which WINS on a conflict. It does not
# write this file: generate-secrets.sh already rewrites .env to rotate the
# database password, and two writers to one file cannot be made safe from
# inside one of them. So those values below are documentation and a fallback
# for a unit that has never been provisioned; editing them on a provisioned
# unit has no effect, and offsite.env is the file to look at.
#
# EMPTY DISABLES EVERYTHING. A unit with no remote does nothing rather than
# failing a timer every half hour, so this stays empty on every unit until that
# unit has been issued its own scoped B2 key.
# Format: <rclone remote>:<bucket>, one bucket per institution.
DTK_OFFSITE_REMOTE=
# The prefix every object of this unit is keyed under inside the bucket:
# lowercase letters and digits joined by single hyphens (ahr, sbmal). Empty
# disables image upload and the catalogue backup. provision-rclone.sh --tenant.
DTK_OFFSITE_TENANT=
# The age X25519 PUBLIC key (age1...) the catalogue dump is encrypted to before
# upload. Unset or invalid: no dump is uploaded. The private key never goes on
# the unit. provision-rclone.sh --dump-recipient.
DTK_OFFSITE_DUMP_RECIPIENT=
# A second remote, <rclone remote>:<bucket> on the same bucket, holding a key
# that may list and read under the tenant prefix. Only an admin restore of
# freed files reads through it; empty makes restore unavailable. Written by
# provision-rclone.sh when it is given a read key.
DTK_OFFSITE_READ_REMOTE=
# Prefix inside the bucket for database dumps, kept away from the image tree so
# a catalogue dump is never mistaken for a capture.
DTK_OFFSITE_DB_PREFIX=db-backups
# Upload cap. Not arbitrary: 750k is what the interim push has sustained on the
# Rionegro unit since 2026-08-20, over a ~12 Mbps link (≈1.5 MB/s measured),
# without starving the web UI the operators are working in at the same time.
# Raising it competes with the people doing the digitizing.
DTK_OFFSITE_BWLIMIT=750k
# The rclone the backend invokes. On a provisioned unit this is overridden
# from offsite.env with the absolute path of the rclone that was actually
# accepted — a pinned build under /usr/local/bin, because apt's 1.60 fails B2
# authentication for application keys created after mid-2024, and fails in a
# way that reads as a wrong key.
DTK_RCLONE_BIN=rclone
# The rclone config file holding this unit's scoped B2 key. Per-unit, mode
# 0600, owned by the appliance user, written at deployment, NEVER in git — the
# same handling as SECRET_KEY and DATABASE_PASSWORD. Overridden from
# offsite.env on a provisioned unit; empty here means rclone's own default
# location.
DTK_RCLONE_CONFIG=
# Overrides the default `docker compose exec -T db pg_dumpall` argv. Needed
# anywhere the appliance's compose overlay is not one directory up: a dev box, a
# container, or a host with a real postgres client on PATH.
DTK_PG_DUMP_COMMAND=
# Delay before the first backup attempt after boot, in seconds. Matches the
# interim timer: late enough that the stack is up and the operator is not
# waiting on it.
DTK_OFFSITE_BACKUP_DELAY=300
# Interval between attempts while the unit is powered, in seconds. 1800 is the
# interim timer's half hour; the units are only on while the archive is open, so
# a missed window is retried the same working day rather than tomorrow.
DTK_OFFSITE_BACKUP_INTERVAL=1800
# Fisqua, which the unit sends each handed-over volume's capture manifest to,
# at https://<tenant>.fisqua.org, or https://<tenant>.staging.fisqua.org in
# staging. Both are written to offsite.env by provision-rclone.sh and are not
# meant to be set here: the token (64 lowercase hex characters) comes from a
# FISQUA_TOKEN= line in the key file named by DTK_OFFSITE_KEY_FILE, never from
# this file, since it is a secret and offsite.env is mode 0600. The
# environment is provision-rclone.sh --fisqua-env production|staging, and a
# token is refused without it.
# DTK_FISQUA_TOKEN=
# DTK_FISQUA_ENV=

# Frontend Configuration
# The unit's mDNS name. setup.sh sets it to captua.local (or
# DTK_HOSTNAME.local), and update.sh to captua.local on a unit renamed from
# digitool. On the appliance the browser calls /api on the page's own origin,
# so the API does not depend on it: it sets the frontend's ORIGIN, and the
# frontend of a release before 0.1.0, which a rollback restores, calls
# http://${HOST_IP}/api. localhost is the development default.
HOST_IP=localhost
# Origins allowed to call the API from another origin: the Vite dev server,
# and, for the code a rollback restores, the frontend container on :3000 (its
# kiosk) and the unit's names. setup.sh and update.sh add the unit's names.
CORS_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:3000"]
