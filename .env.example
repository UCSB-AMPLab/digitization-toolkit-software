# Database Configuration
DATABASE_NAME=digitoolkit
DATABASE_USER=dtkadmin
DATABASE_PASSWORD=change-this-in-production
DATABASE_HOST=localhost  # Use 'localhost' for native backend, 'db' for Docker backend

# Application Configuration
APP_ENV=dev
SECRET_KEY=your-secret-key-here-change-in-production
DTK_DATA_DIR=/var/lib/dtk
DTK_LOG_DIR=/var/log/dtk
PROJECTS_ROOT=/var/lib/dtk/projects

# Server Configuration
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
LOG_LEVEL=info

# Camera Configuration
CAMERA_BACKEND=picamera2

# Frontend Configuration
# PUBLIC_API_BASE=http://localhost:8000
