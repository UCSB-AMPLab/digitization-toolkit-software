# Database Configuration
DATABASE_NAME=digitoolkit
DATABASE_USER=dtkadmin
DATABASE_PASSWORD=change-this-in-production
DATABASE_HOST=localhost  # For production (native backend). Docker mode auto-overrides to 'db'
DATABASE_PORT=5432

# Application Configuration
# APP_ENV: use dev/development/test/local for development. Any other value (e.g. production)
# makes the backend refuse to start unless SECRET_KEY is set to a strong, unique value
APP_ENV=dev
# Generate a real key for production with: openssl rand -hex 32
SECRET_KEY=secret-key-here-change-in-production
# Session lifetime in seconds (default 28800 = 8 hours). A deactivated user keeps a
# working session until their token expires, so shorten this on units in shared spaces.
ACCESS_TOKEN_EXPIRE_SECONDS=28800
DTK_DATA_DIR=/var/lib/dtk
DTK_LOG_DIR=/var/log/dtk
PROJECTS_ROOT=/var/lib/dtk/projects
# Optional: override the exports directory (defaults to DTK_DATA_DIR/exports)
DTK_EXPORTS_DIR=/var/lib/dtk/exports
# Application-level cap on uploaded image size, in bytes (default 104857600 = 100 MB).
# Enforced while streaming, so it protects the SD card even when nginx is not in front.
DTK_MAX_UPLOAD_BYTES=104857600

# Camera Configuration
# Currently available backends: picamera2, gphoto2
CAMERA_BACKEND=picamera2

# Frontend Configuration
# Set HOST_IP to the Pi's hostname or IP for network access (e.g. digitool.local or 10.0.0.133)
# Leave unset or use localhost for local dev
HOST_IP=localhost
# Add origins for both the port-80 Nginx URL and the direct port-3000 fallback.
CORS_ORIGINS=["http://localhost","http://localhost:5173","http://localhost:3000"]
# Browser-side API calls are routed through Nginx (/api → backend:8000)
PUBLIC_API_BASE=http://${HOST_IP}/api